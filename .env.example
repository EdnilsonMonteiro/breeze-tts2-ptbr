# Copie para .env e ajuste. O .env nao vai para o git.
# Este repo baixa automaticamente o modelo base e o adapter LoRA do Hugging Face
# na primeira execucao; so e preciso internet e (as vezes) um token HF.

# Onde guardar modelo base + adapters (fora do repositorio).
# Default: ./artifacts
PTBR_ARTIFACTS=C:\IA\Breeze-tts

# --- downloads (Hugging Face) ---
# Modelo base (obrigatorio; licenca research/non-commercial).
# BREEZE_BASE_MODEL_REPO=BreezeBlue/Breeze-TTS-2
# Adapter LoRA pt-BR (deixe vazio para nao baixar; troque quando publicar o seu).
# PTBR_ADAPTER_REPO=EdnilsonMonteiro/Breeze-TTS-2-lora-ptbr
# Token (necessario se o repo for gated): https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxx

# --- caminhos avancados (defaults abaixo) ---
# BREEZE_TTS_REPO=                  # engine (default: ./breeze-tts, o submodulo)
# BREEZE_CKPT=                      # default: <PTBR_ARTIFACTS>/models/Breeze-TTS-2
# BREEZE_TRAINING_DIR=              # default: <PTBR_ARTIFACTS>/training
# PTBR_ADAPTERS_DIR=               # adapters locais (default: <training>/runs)
# PTBR_HF_ADAPTERS_DIR=            # adapters baixados (default: <PTBR_ARTIFACTS>/adapters)
# PTBR_OUT_DIR=                    # saida de audio da UI (default: <training>/ui_out)
# BREEZE_PY=                       # interpretador python (run.bat)
