# Copie para .env e ajuste. O .env nao vai para o git.
# Este repo baixa automaticamente o MODELO BASE do Hugging Face na primeira execucao.
# O adaptador LoRA e baixado pela propria UI (botao "Baixar modelo...") para a pasta
# adapters/ NA RAIZ DO REPO, cujo conteudo e ignorado pelo git (adapters/.gitignore).

# Onde guardar o modelo base + artefatos (fora do repositorio).
# Default: ./artifacts
PTBR_ARTIFACTS=/path/to/artifacts

# --- downloads (Hugging Face) ---
# Modelo base (obrigatorio; licenca research/non-commercial).
# BREEZE_BASE_MODEL_REPO=BreezeBlue/Breeze-TTS-2
# Adapter LoRA pt-BR usado pelo botao de download da UI
# (deixe vazio para nao oferecer download: PTBR_ADAPTER_REPO=).
# PTBR_ADAPTER_REPO=EdnilsonMonts/Breeze-tts-2-brazillian-lora
# Token (necessario se o repo for gated): https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxx

# --- caminhos avancados (defaults abaixo) ---
# BREEZE_TTS_REPO=                  # engine (default: ./breeze-tts, o submodulo)
# BREEZE_CKPT=                      # default: <PTBR_ARTIFACTS>/models/Breeze-TTS-2
# BREEZE_TRAINING_DIR=              # default: <PTBR_ARTIFACTS>/training
# PTBR_REPO_ADAPTERS_DIR=           # adapters na raiz do repo (default: <repo>/adapters)
# PTBR_ADAPTERS_DIR=                # pasta principal de adapters (default: <PTBR_REPO_ADAPTERS_DIR>)
# PTBR_TRAINING_RUNS_DIR=           # checkpoints de treino (default: <training>/runs)
# PTBR_HF_ADAPTERS_DIR=             # adapters de versoes antigas (default: <PTBR_ARTIFACTS>/adapters)
# PTBR_OUT_DIR=                     # saida de audio da UI (default: <training>/ui_out)
# BREEZE_PY=                        # interpretador python (ui/run.bat e ui/run.sh)
